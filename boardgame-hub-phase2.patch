+const TREASURE_SHAPES: Record<
+  number,
+  string
+> = {
+  1: "40,5 75,68 5,68",
+  2: "10,10 70,10 70,70 10,70",
+  3: "40,3 77,30 63,75 17,75 3,30",
+  4: "20,5 60,5 78,40 60,75 20,75 2,40",
+};
+
+const TREASURE_COLORS: Record<
+  number,
+  string
+> = {
+  1: "#d6b78a",
+  2: "#94a3b8",
+  3: "#60a5fa",
+  4: "#a78bfa",
+};
+
+function TreasureChip({
+  tile,
+}: {
+  tile: TrackTile;
+}) {
+  if (
+    tile.type === "blank" ||
+    !tile.bundle
+  ) {
+    return (
+      <div className="dsa-chip-blank">
+        <span />
+      </div>
+    );
+  }
+
+  const treasures = tile.bundle.treasures;
+
+  const level =
+    treasures[0]?.level ?? 1;
+
+  const count = treasures.length;
+
+  return (
+    <div
+      className={
+        `dsa-treasure-chip dsa-level-${level}`
+      }
+      aria-label={
+        `Level ${level} treasure, ${count} chips`
+      }
+    >
+      <svg
+        viewBox="0 0 90 90"
+        aria-hidden="true"
+      >
+        {treasures
+          .slice(1)
+          .reverse()
+          .map((treasure, index) => (
+            <polygon
+              key={treasure.id}
+              points={
+                TREASURE_SHAPES[
+                  treasure.level
+                ]
+              }
+              fill={
+                TREASURE_COLORS[
+                  treasure.level
+                ]
+              }
+              stroke="#ffffff60"
+              strokeWidth="2"
+              strokeLinejoin="round"
+              transform={
+                `translate(${8 - index * 3} ${
+                  10 - index * 3
+                })`
+              }
+            />
+          ))}
+
+        <polygon
+          points={TREASURE_SHAPES[level]}
+          fill={TREASURE_COLORS[level]}
+          stroke="#ffffff90"
+          strokeWidth="3"
+          strokeLinejoin="round"
+        />
+
+        <polygon
+          points={TREASURE_SHAPES[level]}
+          fill="none"
+          stroke="#00000035"
+          strokeWidth="2"
+          transform="
+            translate(8 8)
+            scale(.8)
+          "
+        />
+      </svg>
+
+      {count > 1 && (
+        <span className="dsa-stack-count">
+          ×{count}
+        </span>
+      )}
+    </div>
+  );
+}
+
+export default function GameBoard({
+  state,
+  animation = null,
+}: Props) {
+  const positions: BoardPosition[] = [
+    getCoordinates(0, "submarine"),
+
+    ...state.track.map((tile, index) =>
+      getCoordinates(index + 1, tile.id),
+    ),
+  ];
+
+  const rows = Math.ceil(
+    state.track.length /
+      BOARD_UI.COLUMNS,
+  );
+
+  const boardWidth =
+    BOARD_UI.COLUMNS *
+      BOARD_UI.CELL_WIDTH +
+    BOARD_UI.PADDING * 2;
+
+  const boardHeight =
+    BOARD_UI.TOP_SPACE +
+    Math.max(0, rows - 1) *
+      BOARD_UI.CELL_HEIGHT +
+    65;
+
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const [scale, setScale] = useState(1);
+  useLayoutEffect(() => {
+    const element = scrollRef.current;
+    if (!element) return;
+    const fit = () => {
+      const desktop = window.innerWidth > 800;
+      const availableHeight = window.innerHeight - element.getBoundingClientRect().top - 18;
+      const widthScale = element.clientWidth / boardWidth;
+      const heightScale = desktop ? availableHeight / boardHeight : 1;
+      setScale(Math.max(desktop ? .55 : .65, Math.min(1, widthScale, heightScale)));
+    };
+    fit();
+    const observer = new ResizeObserver(fit);
+    observer.observe(element);
+    window.addEventListener("resize", fit);
+    return () => { observer.disconnect(); window.removeEventListener("resize", fit); };
+  }, [boardWidth, boardHeight]);
+
+  const route = positions
+    .map(({ x, y }) => `${x},${y}`)
+    .join(" ");
+
+  return (
+    <section className="dsa-board-panel">
+      <div className="dsa-board-scroll" ref={scrollRef}>
+        <div className="dsa-board-fit" style={{ width: boardWidth * scale, height: boardHeight * scale }}>
+        <div
+          className="dsa-board-canvas"
+          style={{
+            width: boardWidth,
+            height: boardHeight,
+            transform: `scale(${scale})`,
+            transformOrigin: "top left",
+          }}
+        >
+          <div className="dsa-water-surface" />
+
+          <div
+            className="dsa-ocean-rays"
+            aria-hidden="true"
+          />
+
+          <div
+            className="dsa-ocean-particles"
+            aria-hidden="true"
+          >
+            {Array.from(
+              { length: 12 },
+              (_, index) => {
+                const random =
+                  createRandom(
+                    `particle-${index}`,
+                  );
+
+                return (
+                  <span
+                    key={index}
+                    style={{
+                      left:
+                        `${random() * 100}%`,
+
+                      top:
+                        `${random() * 100}%`,
+
+                      width:
+                        `${2 + random() * 5}px`,
+
+                      height:
+                        `${2 + random() * 5}px`,
+
+                      animationDelay:
+                        `${-random() * 12}s`,
+
+                      animationDuration:
+                        `${8 + random() * 8}s`,
+                    }}
+                  />
+                );
+              },
+            )}
+          </div>
+
+          <svg
+            className="dsa-board-route"
+            width={boardWidth}
+            height={boardHeight}
+            aria-hidden="true"
+          >
+            <polyline
+              points={route}
+              fill="none"
+              stroke="#a5f3fc"
+              strokeOpacity=".2"
+              strokeWidth="2"
+              strokeDasharray="4 8"
+              strokeLinecap="round"
+              strokeLinejoin="round"
+            />
+          </svg>
+
+          {/* Submarine */}
+          <div
+            className="dsa-board-cell dsa-board-submarine"
+            style={{
+              left: positions[0].x,
+              top: positions[0].y,
+              ...getFloatingStyle(
+                positions[0],
+              ),
+            }}
+          >
+            <div className="dsa-float-motion">
+              <Submarine />
+            </div>
+          </div>
+
+          {/* Treasure track */}
+          {state.track.map((tile, index) => {
+            const position =
+              positions[index + 1];
+
+            return (
+              <div
+                key={tile.id}
+                className="dsa-board-cell"
+                style={{
+                  left: position.x,
+                  top: position.y,
+
+                  ...getFloatingStyle(
+                    position,
+                  ),
+                }}
+              >
+                <div className="dsa-float-motion">
+                  <div className="dsa-treasure-rotation">
+                    <TreasureChip tile={tile} />
+                  </div>
+                </div>
+              </div>
+            );
+          })}
+
+          {/* Independent diver layer */}
+          <div className="dsa-diver-layer">
+            {state.players.map(
+              (player, index) => {
+                const currentAnimation =
+                  animation?.playerId ===
+                    player.id
+                    ? animation
+                    : null;
+
+                const position =
+                  currentAnimation?.position ??
+                  player.diver.position;
+
+                const direction =
+                  currentAnimation?.direction ??
+                  player.diver.direction;
+
+                const coordinates =
+                  positions[position] ??
+                  positions[0];
+
+                const atSubmarine =
+                  position === 0;
+
+                const offsetX =
+                  atSubmarine
+                    ? (index % 3 - 1) * 34
+                    : 0;
+
+                const offsetY =
+                  atSubmarine
+                    ? Math.floor(index / 3) * 18
+                    : 0;
+
+                const duration =
+                  currentAnimation?.duration ??
+                  0;
+
+                const active =
+                  state.phase === "playing" &&
+                  state.currentPlayerIndex ===
+                    index;
+
+                const jumping =
+                  currentAnimation?.isJumping ??
+                  false;
+
+                return (
+                  <div
+                    key={player.id}
+                    className="dsa-diver-position"
+                    style={{
+                      transform:
+                        `translate3d(
+                          ${
+                            coordinates.x -
+                            BOARD_UI.DIVER_WIDTH / 2 +
+                            offsetX
+                          }px,
+                          ${
+                            coordinates.y -
+                            (BOARD_UI.DIVER_HEIGHT - 5) +
+                            offsetY
+                          }px,
+                          0
+                        )`,
+
+                      transitionDuration:
+                        jumping
+                          ? `${duration}ms`
+                          : "0ms",
+
+                      zIndex: active ? 50 : 10,
+
+                      "--diver-jump-duration":
+                        `${duration || 350}ms`,
+
+                      ...getFloatingStyle(
+                        coordinates,
+                      ),
+                    } as CSSProperties}
+                  >
+                    <div
+                      className={
+                        jumping
+                          ? "dsa-diver-float dsa-diver-float--jumping"
+                          : "dsa-diver-float"
+                      }
+                    >
+                      <Diver
+                        name={player.name}
+                        color={
+                          PLAYER_COLORS[
+                            index %
+                            PLAYER_COLORS.length
+                          ]
+                        }
+                        direction={direction}
+                        facingLeft={
+                          getFacingLeft(
+                            position,
+                            direction,
+                          )
+                        }
+                        isJumping={jumping}
+                        isTurning={
+                          currentAnimation
+                            ?.isTurning
+                        }
+                        isActive={active}
+                        isReturned={
+                          player.diver.returned
+                        }
+                      />
+                    </div>
+                  </div>
+                );
+              },
+            )}
+          </div>
+
+          <div
+            className="dsa-ocean-floor"
+            aria-hidden="true"
+          />
+        </div>
+        </div>
+      </div>
+    </section>
+  );
+}
