+              {error}
+            </p>
+          )}
+                </aside>
+      </div>
+
+{!isBusy && state.phase !== "playing" && state.phase !== "setup" && (
+  <ScoreBoard
+    key={state.round}
+    state={state}
+    previousTreasureCounts={
+      previousTreasureCountsRef.current
