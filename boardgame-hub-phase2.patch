+import { useLayoutEffect, useRef, useState } from "react";
+import type { CSSProperties } from "react";
+
+import type {
+  GameState,
+  TrackTile,
+} from "@boardgame-hub/abyss-relay/types";
+
+import type {
+  DiverAnimationState,
+} from "../hooks/useDiverAnimation";
+
+import {
+  PLAYER_COLORS,
+  BOARD_UI,
+} from "../constants/ui";
+
+import Diver from "./Diver";
+
+interface Props {
+  state: GameState;
+  animation?: DiverAnimationState | null;
+}
+
+interface BoardPosition {
+  x: number;
+  y: number;
+  rotation: number;
+  floatX: number;
+  floatY: number;
+  duration: number;
+  delay: number;
+}
+
+function createRandom(seed: string) {
+  let hash = 2166136261;
+
+  for (let i = 0; i < seed.length; i++) {
+    hash ^= seed.charCodeAt(i);
+    hash = Math.imul(hash, 16777619);
+  }
+
+  return () => {
+    hash = (hash + 0x6d2b79f5) | 0;
+
+    let t = Math.imul(
+      hash ^ (hash >>> 15),
+      1 | hash,
+    );
+
+    t ^= t + Math.imul(
+      t ^ (t >>> 7),
+      61 | t,
+    );
+
+    return (
+      ((t ^ (t >>> 14)) >>> 0) /
+      4294967296
+    );
+  };
+}
+
+function getCoordinates(
+  position: number,
+  tileId: string,
+): BoardPosition {
+  if (position === 0) {
+    return {
+      x: BOARD_UI.SUBMARINE_X,
+      y: BOARD_UI.SUBMARINE_Y,
+      rotation: 0,
+      floatX: 1,
+      floatY: 3,
+      duration: 5000,
+      delay: 0,
+    };
+  }
+
+  const random = createRandom(tileId);
+
+  const index = position - 1;
+
+  const row = Math.floor(
+    index / BOARD_UI.COLUMNS,
+  );
+
+  const offset = index % BOARD_UI.COLUMNS;
+
+  const column =
+    row % 2 === 0
+      ? offset
+      : BOARD_UI.COLUMNS - 1 - offset;
+
+  const randomX =
+    (random() * 2 - 1) *
+    BOARD_UI.RANDOM_OFFSET_X;
+
+  const randomY =
+    (random() * 2 - 1) *
+    BOARD_UI.RANDOM_OFFSET_Y;
+
+  const rotation =
+    (random() * 2 - 1) *
+    BOARD_UI.RANDOM_ROTATION;
+
+  const floatX =
+    BOARD_UI.FLOAT_MIN_X +
+    random() *
+      (
+        BOARD_UI.FLOAT_MAX_X -
+        BOARD_UI.FLOAT_MIN_X
+      );
+
+  const floatY =
+    BOARD_UI.FLOAT_MIN_Y +
+    random() *
+      (
+        BOARD_UI.FLOAT_MAX_Y -
+        BOARD_UI.FLOAT_MIN_Y
+      );
+
+  const duration =
+    BOARD_UI.FLOAT_MIN_DURATION +
+    random() *
+      (
+        BOARD_UI.FLOAT_MAX_DURATION -
+        BOARD_UI.FLOAT_MIN_DURATION
+      );
+
+  return {
+    x:
+      BOARD_UI.PADDING +
+      column * BOARD_UI.CELL_WIDTH +
+      BOARD_UI.CELL_WIDTH / 2 +
+      randomX,
+
+    y:
+      BOARD_UI.TOP_SPACE +
+      row * BOARD_UI.CELL_HEIGHT +
+      randomY,
+
+    rotation,
+    floatX,
+    floatY,
+    duration,
+
+    delay: -random() * duration,
+  };
+}
+
+function getFloatingStyle(
+  position: BoardPosition,
+): CSSProperties {
+  return {
+    "--float-x": `${position.floatX}px`,
+    "--float-y": `${position.floatY}px`,
+    "--float-duration": `${position.duration}ms`,
+    "--float-delay": `${position.delay}ms`,
+    "--treasure-rotation":
+      `${position.rotation}deg`,
+  } as CSSProperties;
+}
+
+function getFacingLeft(
+  position: number,
+  direction: "outward" | "inward",
+): boolean {
+  if (position === 0) {
+    return direction === "inward";
+  }
+
+  const row = Math.floor(
+    (position - 1) / BOARD_UI.COLUMNS,
+  );
+
+  const outwardFacesLeft = row % 2 !== 0;
+
+  return direction === "outward"
+    ? outwardFacesLeft
+    : !outwardFacesLeft;
+}
