+  });
+
+  it("does not allow picking up when all blank chips are in use", () => {
+    const state = setupGame(["Player 1", "Player 2"]);
+
+    for (let i = 0; i < 12; i++) {
+      state.track[i] = {
+        ...state.track[i],
+        type: "blank",
+        bundle: null,
+      };
