index 0000000000000000000000000000000000000000..51166c00b779c68337df72869a6b7ad689ab96a6
--- /dev/null
+++ b/packages/abyss-relay/src/engine/treasure.ts
@@ -0,0 +1,200 @@
+
+import { GAME_RULES } from "../rules/constants.js";
+import type {
+  GameState,
+  Player,
+  PlayerId,
+  TrackTile,
+} from "../types/index.js";
+
+/**
+ * Get the current player and validate their identity.
+ */
+function getTreasurePlayer(
+  state: GameState,
+  playerId: PlayerId,
+): Player {
+  if (state.phase !== "playing") {
+    throw new Error("The game is not currently playing.");
+  }
+
+  const player = state.players[state.currentPlayerIndex];
+
+  if (!player || player.id !== playerId) {
+    throw new Error("Only the current player can perform this action.");
+  }
+
+  if (player.diver.returned) {
+    throw new Error("The diver has already returned.");
+  }
+
+  return player;
+}
+
+/**
+ * Convert diver position to track array index.
+ */
+function getTileIndex(player: Player): number {
+  return player.diver.position - 1;
+}
+
+/**
+ * Check whether the player can pick up treasure.
+ */
+export function canPickUpTreasure(
+  state: GameState,
+  player: Player,
+): boolean {
+  if (
+    state.phase !== "playing" ||
+    state.players[state.currentPlayerIndex]?.id !== player.id ||
+    player.diver.returned ||
+    player.diver.position <= 0
+  ) {
+    return false;
+  }
+
+  const tile = state.track[getTileIndex(player)];
+
+  const usedBlankTiles = state.track.filter(
+    (item) => item.type === "blank",
+  ).length;
+
+  return (
+    tile !== undefined &&
+    tile.type === "treasure" &&
+    tile.bundle !== null &&
+    usedBlankTiles < GAME_RULES.BLANK_TILES
+  );
+}
+
+/**
+ * Check whether the player can drop treasure.
+ */
+export function canDropTreasure(
+  state: GameState,
+  player: Player,
+): boolean {
+  if (
+    state.phase !== "playing" ||
+    state.players[state.currentPlayerIndex]?.id !== player.id ||
+    player.diver.returned ||
+    player.diver.position <= 0 ||
+    player.cargo.length === 0
+  ) {
+    return false;
+  }
+
+  const tile = state.track[getTileIndex(player)];
+
+  return (
+    tile !== undefined &&
+    tile.type === "blank" &&
+    tile.bundle === null
+  );
+}
+
+/**
+ * Pick up the treasure bundle at the player's position.
+ */
+export function pickUpTreasure(
+  state: GameState,
+  playerId: PlayerId,
+): GameState {
+  const player = getTreasurePlayer(state, playerId);
+
+  if (!canPickUpTreasure(state, player)) {
+    throw new Error("Cannot pick up treasure at this position.");
+  }
+
+  const tileIndex = getTileIndex(player);
+  const tile = state.track[tileIndex];
+  const bundle = tile.bundle;
+
+  if (!bundle) {
+    throw new Error("Treasure bundle does not exist.");
+  }
+
+  // Replace the treasure with a blank tile.
+  const updatedTrack = state.track.map(
+    (item, index): TrackTile =>
+      index === tileIndex
+        ? {
+            ...item,
+            type: "blank",
+            bundle: null,
+          }
+        : item,
+  );
+
+  // Add the entire bundle to the player's cargo.
+  const updatedPlayers = state.players.map((item) =>
+    item.id === playerId
+      ? {
+          ...item,
+          cargo: [...item.cargo, bundle],
+        }
+      : item,
+  );
+
+  return {
+    ...state,
+    track: updatedTrack,
+    players: updatedPlayers,
+  };
+}
+
+/**
+ * Drop a selected treasure bundle onto a blank tile.
+ */
+export function dropTreasure(
+  state: GameState,
+  playerId: PlayerId,
+  bundleId: string,
+): GameState {
+  const player = getTreasurePlayer(state, playerId);
+
+  if (!canDropTreasure(state, player)) {
+    throw new Error("Cannot drop treasure at this position.");
+  }
+
+  const bundle = player.cargo.find(
+    (item) => item.id === bundleId,
+  );
+
+  if (!bundle) {
+    throw new Error("Treasure bundle not found in cargo.");
+  }
+
+  const tileIndex = getTileIndex(player);
+
+  // Replace the blank tile with the selected bundle.
+  const updatedTrack = state.track.map(
+    (item, index): TrackTile =>
+      index === tileIndex
+        ? {
+            ...item,
+            type: "treasure",
+            bundle,
+          }
+        : item,
+  );
+
+  // Remove the selected bundle from cargo.
+  const updatedPlayers = state.players.map((item) =>
+    item.id === playerId
+      ? {
+          ...item,
+          cargo: item.cargo.filter(
+            (cargoBundle) => cargoBundle.id !== bundleId,
+          ),
+        }
+      : item,
+  );
+
+  return {
+    ...state,
+    track: updatedTrack,
+    players: updatedPlayers,
+  };
+}
diff --git a/packages/abyss-relay/src/engine/turn.ts b/packages/abyss-relay/src/engine/turn.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f8ec3456d0a033ad1a45ab29cbca989d7d224e6f
--- /dev/null
+++ b/packages/abyss-relay/src/engine/turn.ts
@@ -0,0 +1,289 @@
+
+import { GAME_RULES } from "../rules/constants.js";
+
+import type {
+  GameState,
+  DiceResult,
+  TurnStage,
+} from "../types/index.js";
+
+import {
+  getCurrentPlayer,
+  getNextPlayerIndex,
+  shouldEndRound,
+} from "./state.js";
+
+import { consumeOxygen } from "./oxygen.js";
+
+import {
+  calculateMovement,
+  moveDiver,
+} from "./movement.js";
+
+import {
+  pickUpTreasure,
+  dropTreasure,
+} from "./treasure.js";
+
+import { endRound } from "./round.js";
+
+function requireStage(
+  state: GameState,
+  stage: TurnStage,
+): void {
+  if (state.phase !== "playing") {
+    throw new Error("The game is not currently playing.");
+  }
+
+  if (state.turnStage !== stage) {
+    throw new Error(
+      `Expected stage: ${stage}. Current stage: ${state.turnStage}.`,
+    );
+  }
+}
+
+/**
+ * Stage 1: Consume oxygen.
+ */
+export function startTurn(
+  state: GameState,
+): GameState {
+  requireStage(state, "breathe");
+
+  const player = getCurrentPlayer(state);
+
+  const updatedState = consumeOxygen(
+    state,
+    player.id,
+  );
+
+  return {
+    ...updatedState,
+    turnStage:
+      player.diver.position === 0 ||
+      player.diver.hasTurned ||
+      player.diver.direction === "inward"
+        ? "swim"
+        : "declare",
+    diceResult: null,
+  };
+}
+
+/**
+ * Stage 2: Declare whether to turn back.
+ */
+export function declareDirection(
+  state: GameState,
+  turnBack: boolean,
+): GameState {
+  requireStage(state, "declare");
+
+  const player = getCurrentPlayer(state);
+
+  if (turnBack) {
+    if (
+      player.diver.hasTurned ||
+      player.diver.direction === "inward"
+    ) {
+      throw new Error(
+        "A diver can only turn back once per round.",
+      );
+    }
+
+    if (player.diver.position === 0) {
+      throw new Error(
+        "The diver cannot turn back at the submarine.",
+      );
+    }
+  }
+
+  const updatedPlayers = state.players.map(
+    (item) =>
+      item.id === player.id && turnBack
+        ? {
+            ...item,
+            diver: {
+              ...item.diver,
+              direction: "inward" as const,
+              hasTurned: true,
+            },
+          }
+        : item,
+  );
+
+  return {
+    ...state,
+    players: updatedPlayers,
+    turnStage: "swim",
+  };
+}
+
+/**
+ * Roll two special dice, each with values 1–3.
+ */
+export function rollDice(
+  random: () => number = Math.random,
+): DiceResult {
+  const roll = () =>
+    Math.floor(
+      random() *
+        (
+          GAME_RULES.DICE_MAX -
+          GAME_RULES.DICE_MIN +
+          1
+        ),
+    ) + GAME_RULES.DICE_MIN;
+
+  const first = roll();
+  const second = roll();
+
+  return {
+    first,
+    second,
+    total: first + second,
+  };
+}
+
+function validateDice(dice: DiceResult): void {
+  const values = [dice.first, dice.second];
+
+  const valid = values.every(
+    (value) =>
+      Number.isInteger(value) &&
+      value >= GAME_RULES.DICE_MIN &&
+      value <= GAME_RULES.DICE_MAX,
+  );
+
+  if (
+    !valid ||
+    dice.total !== dice.first + dice.second
+  ) {
+    throw new Error("Invalid dice result.");
+  }
+}
+
+/**
+ * Stage 3: Roll dice and move the current diver.
+ */
+export function swim(
+  state: GameState,
+  dice: DiceResult = rollDice(),
+): GameState {
+  // Rolling without declaring means continuing
+  // in the current direction.
+  const preparedState =
+    state.turnStage === "declare"
+      ? declareDirection(state, false)
+      : state;
+
+  requireStage(preparedState, "swim");
+  validateDice(dice);
+
+  const player = getCurrentPlayer(preparedState);
+
+  const steps = calculateMovement(
+    dice.total,
+    player.cargo.length,
+  );
+
+  const movedState = moveDiver(
+    preparedState,
+    player,
+    steps,
+  );
+
+  const movedPlayer = getCurrentPlayer(movedState);
+
+  const updatedState: GameState = {
+    ...movedState,
+    diceResult: dice,
+    turnStage: "treasure",
+  };
+
+  // A returned diver cannot perform treasure actions.
+  if (movedPlayer.diver.returned) {
+    return finishTurn({
+      ...updatedState,
+      lastReturnPlayerIndex:
+        movedState.currentPlayerIndex,
+    });
+  }
+
+  return updatedState;
+}
+
+/**
+ * Finish the current player's turn.
+ */
+function finishTurn(
+  state: GameState,
+): GameState {
+  requireStage(state, "treasure");
+
+  if (shouldEndRound(state)) {
+    return endRound(state);
+  }
+
+  const nextPlayerIndex =
+    getNextPlayerIndex(state);
+
+  if (nextPlayerIndex === null) {
+    return endRound(state);
+  }
+
+  return {
+    ...state,
+    currentPlayerIndex: nextPlayerIndex,
+    turnStage: "breathe",
+    diceResult: null,
+  };
+}
+
+/**
+ * Stage 4: Pick up treasure and finish the turn.
+ */
+export function takeTreasure(
+  state: GameState,
+): GameState {
+  requireStage(state, "treasure");
+
+  const player = getCurrentPlayer(state);
+
+  const updatedState = pickUpTreasure(
+    state,
+    player.id,
+  );
+
+  return finishTurn(updatedState);
+}
+
+/**
+ * Stage 4: Drop treasure and finish the turn.
+ */
+export function leaveTreasure(
+  state: GameState,
+  bundleId: string,
+): GameState {
+  requireStage(state, "treasure");
+
+  const player = getCurrentPlayer(state);
+
+  const updatedState = dropTreasure(
+    state,
+    player.id,
+    bundleId,
+  );
+
+  return finishTurn(updatedState);
+}
+
+/**
+ * Stage 4: Do nothing and finish the turn.
+ */
+export function skipTreasure(
+  state: GameState,
+): GameState {
+  requireStage(state, "treasure");
+
+  return finishTurn(state);
+}
